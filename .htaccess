# ===== Painel de Coletas — PISF =====

# Cache: sempre revalidar o HTML e os PDFs das fichas, para que o navegador
# nunca sirva uma versao antiga do painel/ficha depois de um deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Força HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# URLs limpas: /index.html vira a raiz do domínio
RewriteCond %{THE_REQUEST} ^GET\s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /admin.html vira /admin
RewriteCond %{THE_REQUEST} ^GET\s/+admin\.html[\s?] [NC]
RewriteRule ^ /admin [R=301,L]

# Internamente, /admin serve admin.html (a URL não muda)
RewriteRule ^admin$ admin.html [L]
